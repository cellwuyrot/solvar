NODE_ENV=development
WEBSITE_URL=http://localhost:4200
AUTH_TRUSTED_ORIGINS=
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=
BETTER_AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
APPLICATION_ID=
VITE_APPLICATION_ID=
VITE_RUNABLE_AUTH_ISSUER=
AUTUMN_SECRET_KEY=

# Server-only. Revoke any token previously shared in chat. Never use VITE_ prefix.
TELEGRAM_BOT_TOKEN=

# Production: set WEBSITE_URL to your real HTTPS domain; NODE_ENV=production
PORT=4200
HOST=127.0.0.1
# Only exact IPs of YOUR reverse proxy. Never trust arbitrary visitor X-Real-IP/XFF.
TRUSTED_PROXY_IPS=
# Stable server-only secret (32+ random chars); if blank BETTER_AUTH_SECRET is used.
ORDER_GUARD_SECRET=
# Set true (and fill both Turnstile keys) for production spam protection; if true without keys, reservations stay closed.
ORDER_CAPTCHA_REQUIRED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# true = background worker sends manager notifications (Telegram/SMTP). Requests are saved even if delivery fails.
NOTIFICATION_WORKER_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Exact HTTPS payment provider hostnames (no wildcard); set to the provider actually used.
PAYMENT_ALLOWED_HOSTS=

# Service mail: obtain host, port, credentials and verified sender from the Trioz panel.
# https://smtp.trioz.ru/ is a control panel, not a confirmed SMTP hostname.
# TLS is required: SMTP_SECURE=true for implicit TLS, false for STARTTLS.
SMTP_ALLOW_INSECURE_LOCAL=false
# Only explicit staging environments may send test Telegram/SMTP probes.
DEPLOYMENT_ENV=local
# Persistent path for snapshots (production example: /var/backups/solvar).
BACKUP_DIR=
# Remote migrations only: reference to a separately verified provider backup.
REMOTE_BACKUP_REFERENCE=

# Visits only (no products/orders). Require Turnstile action=visit; fail closed by default.
VISIT_CAPTCHA_REQUIRED=true
